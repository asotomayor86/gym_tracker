# Cadena de conexión de Neon (Vercel > Storage > Neon). Para migraciones: DATABASE_URL_UNPOOLED (conexión directa).
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Cadena aleatoria larga (>= 16 caracteres) para firmar los tokens de acceso (p. ej. openssl rand -hex 32)
AUTH_SECRET=
# Dominio público de la app (enlaces de invitación). Opcional: si falta se deduce de la petición.
APP_ORIGIN=
# Solo en el .env LOCAL, para `npx tsx scripts/bootstrap-admin.ts` (no se sube a Vercel)
ADMIN_EMAIL=
ADMIN_PASSWORD=
